LOCAL_PATH:= $(call my-dir)

include $(CLEAR_VARS)
LOCAL_MODULE:= chat
LOCAL_SRC_FILES:= \
        chat.c
LOCAL_SHARED_LIBRARIES := \
        libcutils libc
LOCAL_CFLAGS := -DANDROID_CHANGES -DTERMIOS -DSIGTYPE=void -UNO_SLEEP -DFNDELAY=O_NDELAY -Wno-unused-parameter -Wno-unused-const-variable
