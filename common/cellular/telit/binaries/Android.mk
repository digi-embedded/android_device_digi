include $(CLEAR_VARS)
LOCAL_MODULE := ip-down-ppp0
LOCAL_SRC_FILES := ip-down-ppp0.c
LOCAL_SHARED_LIBRARIES := libcutils liblog libc
LOCAL_MODULE_PATH := $(TARGET_OUT_ETC)/ppp
include $(BUILD_EXECUTABLE)
